<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <IsPackable>true</IsPackable>
    <PreserveCompilationContext>true</PreserveCompilationContext>

  <Version Condition="'$(Version)' == ''">0.13.0</Version>
    <Authors>Wilderness Labs</Authors>
    <Company>Wilderness Labs</Company>
    <PackageDescription>Core library for Chloroplast.Tool</PackageDescription>
    <RepositoryUrl>https://github.com/WildernessLabs/Chloroplast</RepositoryUrl>
 
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="9.0.6" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="9.0.6" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.6" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Content\" />
    <Folder Include="Rendering\" />
    <Folder Include="Extensions\" />
    <Folder Include="Config\" />
    <Folder Include="Loaders\" />
  </ItemGroup>
</Project>
